# SafeNav Backend Environment Variables
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Credentials (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key for backend / provisioning (DO NOT EXPOSE TO FRONTEND)
SUPABASE_KEY=your-supabase-service-role-key
# JWT Secret (Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
