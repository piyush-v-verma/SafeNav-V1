# SafeNav Backend
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase STAGING credentials
SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_STAGING_SECRET_OR_SERVICE_ROLE_KEY
# ES256 JWT verification uses the project's JWKS endpoint; blank values derive from SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_ALLOW_INSECURE_LOCAL=false
# Legacy SUPABASE_JWT_SECRET is intentionally not used; HS256 tokens are rejected.

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
